# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit it.

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-5-5

# Beta header for the MCP connector. If you get a 400 mentioning the beta
# header, check the current value in the Anthropic MCP connector docs.
MCP_BETA_HEADER=mcp-client-2025-11-20

# ---------- NetSuite account ----------
# From Setup > Company > Company Information > ACCOUNT ID.
# Underscores become hyphens and lowercase: 1234567_SB1 -> 1234567-sb1
NS_ACCOUNT=1234567-sb1

NS_MCP_URL=https://1234567-sb1.suitetalk.api.netsuite.com/services/mcp/v1/suiteapp/com.netsuite.mcpstandardtools

# ---------- NetSuite OAuth ----------
# From the integration record. Shown only once when you first save it.
NS_CLIENT_ID=
NS_CLIENT_SECRET=

# The bot's shared login, written by npm run pkce. The access token lasts
# ~1 hour and refreshes automatically. The refresh token is NOT replaced on
# refresh, so it dies 7 days after npm run pkce: run it again weekly.
NS_ACCESS_TOKEN=
NS_REFRESH_TOKEN=

# Managed automatically. Epoch ms when the access token expires, written on
# every refresh. Leave empty; do not edit by hand.
NS_TOKEN_EXPIRES_AT=

# Token endpoint host. Defaults to <NS_ACCOUNT>.suitetalk.api.netsuite.com.
# Oracle's docs disagree on the host; if refresh returns 404, use this:
# NS_TOKEN_HOST=1234567-sb1.app.netsuite.com

# Used only by src/pkce.js and the initial authorization.
NS_REDIRECT_URI=https://localhost/callback

# ---------- Personal NetSuite sign-in (Teams) ----------
# Lets each person say "sign in" in Teams and use their own NetSuite role.
# Off when NS_SIGNIN_REDIRECT_URI is empty. The URI must be https, reach this
# bot (dev tunnel or host), and be added to the integration record's
# redirect URIs exactly as written here.
# NS_SIGNIN_REDIRECT_URI=https://your-tunnel-3978.use.devtunnels.ms/auth/netsuite/callback

# Encrypts each person's tokens on disk. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out.
NS_USER_TOKENS_KEY=

# Where the encrypted tokens live. Defaults to data/user-tokens.enc. When
# hosted, point outside the deployed folder or every deploy signs everyone out.
# NS_USER_TOKENS_FILE=/home/user-tokens.enc

# true: people must sign in before asking. Otherwise anyone not signed in is
# answered with the shared login above.
# NS_SIGNIN_REQUIRED=true

# ---------- Conversation ----------
# NetSuite results older than this are dropped from history, so follow-ups
# fetch fresh data instead of reusing stale numbers.
RESULT_TTL_MINUTES=60

# Answers show when their data was pulled, in the server's local time. A
# hosted server runs in UTC; set this there so the times match the office.
# TZ=America/Detroit

# ---------- Spend limits ----------
# Per-person dollar limits per 4 hours, week and month, with department
# defaults, in limits.jsonc (see README). Point elsewhere when hosted so a
# deploy does not overwrite edits made through Teams.
# LIMITS_FILE=/home/limits.jsonc

# Who may use the "limit" commands in Teams: emails, or Entra object IDs
# until the Graph permission is granted. Comma-separated.
LIMIT_ADMINS=

# ---------- Teams (npm run teams) ----------
# From the Azure Bot registration. Not needed for npm run teams:local.
# Prefixed TEAMS_ so they cannot be confused with NS_CLIENT_ID/NS_CLIENT_SECRET.
TEAMS_CLIENT_ID=
TEAMS_TENANT_ID=
TEAMS_CLIENT_SECRET=
PORT=3978
