# Copy this file to .env and fill in real values.
# .env is gitignored. Never commit it.

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
CLAUDE_MODEL=claude-sonnet-5-5

# Beta header for the MCP connector. If you get a 400 mentioning the beta
# header, check the current value in the Anthropic MCP connector docs.
MCP_BETA_HEADER=mcp-client-2025-04-04

# ---------- NetSuite account ----------
# From Setup > Company > Company Information > ACCOUNT ID.
# Underscores become hyphens and lowercase: 1234567_SB1 -> 1234567-sb1
NS_ACCOUNT=1234567-sb1

NS_MCP_URL=https://1234567-sb1.suitetalk.api.netsuite.com/services/mcp/v1/suiteapp/com.netsuite.mcpstandardtools

# ---------- NetSuite OAuth ----------
# From the integration record. Shown only once when you first save it.
NS_CLIENT_ID=
NS_CLIENT_SECRET=

# Written by npm run pkce, then rotated automatically. Access token lasts
# ~1 hour, refresh token 7 days. Each refresh replaces both.
NS_ACCESS_TOKEN=
NS_REFRESH_TOKEN=

# Managed automatically. Epoch ms when the access token expires, written on
# every refresh. Leave empty; do not edit by hand.
NS_TOKEN_EXPIRES_AT=

# Token endpoint host. Defaults to <NS_ACCOUNT>.suitetalk.api.netsuite.com.
# Oracle's docs disagree on the host; if refresh returns 404, use this:
# NS_TOKEN_HOST=1234567-sb1.app.netsuite.com

# Used only by src/pkce.js and the initial authorization.
NS_REDIRECT_URI=https://localhost/callback
